{
	"name": "nestjs-azure-sdk",
	"version": "2.0.0",
	"description": "Integração simples e idiomática entre NestJS e Azure Service Bus, Blob Storage e Queue Storage.",
	"author": {
		"name": "Gabriel Laroca Barbosa",
		"email": "gabriellb438@gmail.com"
	},
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gabriellaroca/nestjs-azure-sdk.git"
	},
	"bugs": {
		"url": "https://github.com/gabriellaroca/nestjs-azure-sdk/issues"
	},
	"homepage": "https://github.com/gabriellaroca/nestjs-azure-sdk#readme",
	"keywords": [
		"azure",
		"blob-storage",
		"nestjs",
		"queue-storage",
		"service-bus"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./service-bus": {
			"types": "./dist/service-bus/index.d.ts",
			"import": "./dist/service-bus/index.js",
			"default": "./dist/service-bus/index.js"
		},
		"./blob-storage": {
			"types": "./dist/blob-storage/index.d.ts",
			"import": "./dist/blob-storage/index.js",
			"default": "./dist/blob-storage/index.js"
		},
		"./queue-storage": {
			"types": "./dist/queue-storage/index.d.ts",
			"import": "./dist/queue-storage/index.js",
			"default": "./dist/queue-storage/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"engines": {
		"node": "^22.0.0 || ^24.0.1"
	},
	"packageManager": "pnpm@11.23.0",
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint src test",
		"test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
		"test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --runInBand",
		"test:integration": "AZURE_LIVE_TESTS=true node --experimental-vm-modules ./node_modules/jest/bin/jest.js test/integration --runInBand",
		"typecheck": "tsc -p tsconfig.test.json",
		"check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && publint",
		"prepublishOnly": "pnpm run check"
	},
	"dependencies": {
		"@azure/core-auth": "^1.11.0",
		"@azure/core-client": "^1.11.0",
		"@azure/identity": "^4.13.2",
		"@azure/service-bus": "^7.9.5",
		"@azure/storage-blob": "^12.33.0",
		"@azure/storage-queue": "^12.31.0"
	},
	"peerDependencies": {
		"@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
		"@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
		"reflect-metadata": "^0.1.13 || ^0.2.0",
		"rxjs": "^7.8.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@jest/globals": "^30.4.1",
		"@nestjs/common": "^12.0.1",
		"@nestjs/core": "^12.0.1",
		"@nestjs/testing": "^12.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.4.0",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"jest": "^30.4.2",
		"prettier": "^3.9.6",
		"publint": "^0.3.24",
		"reflect-metadata": "^0.2.2",
		"rimraf": "^6.1.3",
		"rxjs": "^7.8.2",
		"ts-jest": "^29.4.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0"
	}
}
